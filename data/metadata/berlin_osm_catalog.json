  "spatial_queries": {
    "examples": [
      {
        "query": "Find all hospitals within 500m of a park",
        "sql": "SELECT h.name, h.geometry FROM vector.osm_hospitals h JOIN vector.osm_parks p ON ST_DWithin(h.geometry::geography, p.geometry::geography, 500)"
      },
      {
        "query": "Find public toilets near transport stops (within 100m)",
        "sql": "SELECT t.name, t.geometry FROM vector.osm_toilets t JOIN vector.osm_transport_stops s ON ST_DWithin(t.geometry::geography, s.geometry::geography, 100)"
      },
      {
        "query": "Count pharmacies within 1km of each hospital",
        "sql": "SELECT h.name as hospital, COUNT(p.osm_id) as pharmacy_count FROM vector.osm_hospitals h LEFT JOIN vector.osm_pharmacies p ON ST_DWithin(h.geometry::geography, p.geometry::geography, 1000) GROUP BY h.name"
      },
      {
        "query": "Find the nearest fire station to each school",
        "sql": "SELECT DISTINCT ON (s.osm_id) s.name as school, f.name as nearest_fire_station, ST_Distance(s.geometry::geography, f.geometry::geography) as distance_m FROM vector.osm_schools s CROSS JOIN vector.osm_fire_stations f ORDER BY s.osm_id, ST_Distance(s.geometry::geography, f.geometry::geography)"
      },
      {
        "query": "Show all street lights in a specific district",
        "sql": "SELECT id, leuchtstelle, status, bezirk, ortsteil, strasse, leuchtentyp, geometry FROM vector.osm_street_lights WHERE bezirk = 'Mitte' ORDER BY ortsteil, strasse"
      },
      {
        "query": "Find street lights near parks (within 100m)",
        "sql": "SELECT DISTINCT s.id, s.leuchtstelle, s.strasse, p.name as nearby_park, ST_Distance(s.geometry::geography, p.geometry::geography) as distance_m FROM vector.osm_street_lights s JOIN vector.osm_parks p ON ST_DWithin(s.geometry::geography, p.geometry::geography, 100) ORDER BY distance_m"
      },
      {
        "query": "Count street lights by district",
        "sql": "SELECT bezirk, COUNT(*) as light_count FROM vector.osm_street_lights GROUP BY bezirk ORDER BY light_count DESC"
      },
      {
        "query": "Find street lights near schools (within 50m)",
        "sql": "SELECT DISTINCT s.id, s.leuchtstelle, s.status, sch.name as school, ST_Distance(s.geometry::geography, sch.geometry::geography) as distance_m FROM vector.osm_street_lights s JOIN vector.osm_schools sch ON ST_DWithin(s.geometry::geography, sch.geometry::geography, 50) ORDER BY distance_m LIMIT 100"
      }
    ]
  },
