# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Gemini API Configuration (Free Tier - get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (Local LLM) Configuration - no API key needed
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODEL_SMALL=qwen3.5:4b
OLLAMA_TIMEOUT=120

# LM Studio (Local LLM) Configuration - no API key needed
# Download LM Studio from https://lmstudio.ai, load your model, start the local server
LMSTUDIO_API_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-4-e4b-it
LMSTUDIO_TIMEOUT=120

# Database Configuration
POSTGRES_USER=geoassist
POSTGRES_PASSWORD=geoassist_password
POSTGRES_DB=geospatial_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Geocoding (Nominatim - self-hosted, no API key required)
NOMINATIM_HOST=localhost
NOMINATIM_PORT=7070
# When running inside Docker: NOMINATIM_HOST=nominatim, NOMINATIM_PORT=8080

# Data Paths
DATA_DIR=./data
RASTER_DIR=./data/raster
VECTOR_DIR=./data/vector
METADATA_DIR=./data/metadata
